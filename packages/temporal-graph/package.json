  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:jest": "jest --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/sql.js": "^1.4.9",
    "@types/node": "^20.0.0",
    "@types/object-hash": "^3.0.4",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "object-hash": "^2.2.0"
